# Local database (SQLite via Prisma's better-sqlite3 adapter). See README for PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"

# Admin auth — the whole /admin and /api/admin surface is gated by proxy.ts.
# Generate with `openssl rand -base64 32`. Never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Test-only header bypass; ignored when NODE_ENV=production. Only playwright.config.ts sets it.
ADMIN_TEST_BYPASS_SECRET=

# Scheduled ingestion. Interval between automatic polling passes (minutes). Default 15.
INGESTION_INTERVAL_MINUTES=15
# Set to 1 to disable the in-process scheduler (manual "Fetch Now" and `npm run ingest` still work).
DISABLE_INGESTION_SCHEDULER=
# Per-request timeout for upstream fetches (ms).
INGESTION_FETCH_TIMEOUT_MS=20000
# Contact string sent in the User-Agent header to upstream publishers.
INGESTION_CONTACT=

# Optional: MapTiler key for the vector street style. Satellite mode uses Esri World Imagery tiles (no key).
NEXT_PUBLIC_MAPTILER_KEY=
