# ─── Database ────────────────────────────────────────────────────────────────────────────────────────────────
# Local development (default): SQLite file, no server needed.
DATABASE_URL="file:./prisma/dev.db"
# Production: PostgreSQL. After switching, run:  npm run db:generate ; npm run db:deploy ; npm run build
# DATABASE_URL="postgresql://vigil:CHANGE_ME@localhost:5432/vigil_outbreak"
# DATABASE_POOL_MAX=10

# ─── Admin auth ──────────────────────────────────────────────────────────────────────────────────────────────
# The whole /admin and /api/admin surface is gated by proxy.ts. Generate long random values. Never commit them.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Test-only header bypass; ignored when NODE_ENV=production. Only playwright.config.ts sets it.
ADMIN_TEST_BYPASS_SECRET=

# ─── Ingestion ───────────────────────────────────────────────────────────────────────────────────────────────
# Where scheduled ingestion runs:
#   inline  in the web process (development default)
#   worker  NOT in the web process; run `npm run worker` or cron `npm run ingest -- --due` (production default)
#   off     no scheduled ingestion (manual "Fetch Now" still works)
INGESTION_MODE=
# Default polling interval (minutes) for newly seeded sources.
INGESTION_INTERVAL_MINUTES=15
# Standalone worker pass interval (seconds). Each pass only fetches sources that are due.
WORKER_TICK_SECONDS=60
# Per-request timeout (ms) and retries for transient failures (timeouts, connection resets, 5xx, 429).
INGESTION_FETCH_TIMEOUT_MS=20000
INGESTION_RETRIES=2
INGESTION_RETRY_BASE_MS=1000
# Contact string sent in the User-Agent header to publishers (e.g. an email or URL). Recommended.
INGESTION_CONTACT=
# Legacy switch: 1 = same as INGESTION_MODE=off.
DISABLE_INGESTION_SCHEDULER=

# ─── Map ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Optional. Satellite mode uses Esri World Imagery tiles (no key).
NEXT_PUBLIC_MAPTILER_KEY=
