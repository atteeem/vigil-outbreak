// VIGIL OUTBREAK — database schema.
//
// Principles (see README "Data integrity"):
// - History is append-only where it matters: case counts are dated OutbreakObservation rows, classification
//   changes are InvestigationStatusHistory rows. Nothing overwrites an earlier reported value.
// - Unknown is not zero: every count is nullable; null means "not reported".
// - Every claim keeps its provenance (source article, official vs media, verification status).
// - Two clocks: `reportedAt`/`publishedAt` = when information became public (drives historical playback);
//   `asOfDate`/`occurredAt`/`eventDate` = when the underlying thing happened.
//
// SQLite has no enum type, so enum-shaped fields are Strings validated at the TypeScript boundary
// (lib/domain/enums.ts). This file is the CANONICAL schema (SQLite, local development). The PostgreSQL schema in
// prisma/postgres/schema.prisma is generated from it by `npm run db:pg:sync` — never edit that copy by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Disease {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  /// Scientific name of the causative agent, when one is established (e.g. "Yersinia pestis").
  pathogen     String?
  /// BACTERIUM | VIRUS | PARASITE | FUNGUS | PRION | TOXIN | UNKNOWN
  pathogenType String
  /// RESPIRATORY | VECTOR_BORNE | ENTERIC | ZOONOTIC | VACCINE_PREVENTABLE | HEMORRHAGIC | OTHER | UNKNOWN
  category     String
  /// Lower-case keywords used by the extractor (JSON string[]).
  keywords     String     @default("[]")
  description  String?
  outbreaks    Outbreak[] @relation("confirmedDisease")
  suspectedIn  Outbreak[] @relation("suspectedDisease")
}

model Outbreak {
  id                 String                       @id @default(cuid())
  slug               String                       @unique
  title              String
  summary            String
  /// Disease established by laboratory confirmation (null while unconfirmed).
  diseaseId          String?
  disease            Disease?                     @relation("confirmedDisease", fields: [diseaseId], references: [id])
  /// Disease under consideration but NOT confirmed.
  suspectedDiseaseId String?
  suspectedDisease   Disease?                     @relation("suspectedDisease", fields: [suspectedDiseaseId], references: [id])
  /// UNCONFIRMED_INVESTIGATION | SUSPECTED_OUTBREAK | CONFIRMED_LOCALIZED | CONFIRMED_WIDESPREAD | RESOLVED
  classification     String
  /// UNKNOWN | UNDER_INVESTIGATION | SUSPECTED | CONFIRMED | RULED_OUT
  pathogenStatus     String
  countryCode        String
  countryName        String
  /// When the event first became publicly known (publication time of the earliest report).
  firstReportedAt    DateTime
  /// When the event itself began, if known.
  eventStartDate     DateTime?
  lastVerifiedAt     DateTime?
  resolvedAt         DateTime?
  featured           Boolean                      @default(false)
  published          Boolean                      @default(false)
  mergedIntoId       String?
  mergedInto         Outbreak?                    @relation("merge", fields: [mergedIntoId], references: [id])
  mergedFrom         Outbreak[]                   @relation("merge")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  locations          OutbreakLocation[]
  observations       OutbreakObservation[]
  updates            OutbreakUpdate[]
  articles           SourceArticle[]
  claims             EvidenceClaim[]
  statusHistory      InvestigationStatusHistory[]
  riskAssessments    RiskAssessment[]
  trackedEvent       TrackedEvent?

  @@index([published, classification])
}

/// An emerging event the product is dedicated to tracking (e.g. the Irkutsk investigation). The primary active
/// one is the subject of the main dashboard and map; others can be added later without code changes.
model TrackedEvent {
  id                String          @id @default(cuid())
  outbreakId        String          @unique
  outbreak          Outbreak        @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  /// Short display name ("Irkutsk investigation").
  name              String
  primary           Boolean         @default(false)
  active            Boolean         @default(true)
  /// Country / first-level region where the event originated; case locations outside them count as spread.
  originCountryCode String
  originAdmin1      String?
  /// JSON string[]: place/institution names; an article must mention one to be considered about this event.
  anchorTerms       String
  /// JSON string[]: event-specific context (pathogen, symptoms, agencies) required alongside a place name.
  contextTerms      String
  /// JSON string[]: wider-area terms that make an article only POSSIBLY related (sent to review, never shown as direct).
  weakAnchorTerms   String          @default("[]")
  mapCenterLat      Float
  mapCenterLng      Float
  mapZoom           Float           @default(8)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  articles          SourceArticle[]
}

model OutbreakLocation {
  id              String         @id @default(cuid())
  outbreakId      String
  outbreak        Outbreak       @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  name            String
  admin1          String?
  countryCode     String
  lat             Float
  lng             Float
  /// EXACT | CITY | ADMIN1 | COUNTRY — how precisely the coordinates are known.
  precision       String
  /// INVESTIGATION_SITE | CONFIRMED_CASE | SUSPECTED_CASE | PRECAUTIONARY_MEASURE | CASE_LOCATION | AFFECTED_AREA.
  /// PRECAUTIONARY_MEASURE (quarantine, observation of contacts, closures) is never an infection.
  role            String
  notes           String?
  /// UNVERIFIED | VERIFIED | DISPUTED | REFUTED. Only VERIFIED locations are drawn on the public map.
  verificationStatus String     @default("VERIFIED")
  /// Evidence supporting the location (required for case locations outside the event's origin).
  evidence        String?
  verifiedAt      DateTime?
  firstReportedAt DateTime
  sourceArticleId String?
  sourceArticle   SourceArticle? @relation(fields: [sourceArticleId], references: [id])
}

model OutbreakObservation {
  id                 String         @id @default(cuid())
  outbreakId         String
  outbreak           Outbreak       @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  /// CONFIRMED_CASES | PROBABLE_CASES | SUSPECTED_CASES | DEATHS | UNDER_OBSERVATION | HOSPITALIZED | CONTACTS_TESTED_NEGATIVE
  metric             String
  /// null = not reported / unknown. Never coerced to 0.
  value              Int?
  /// Upper bound when a source reports a range (e.g. "189–197 contacts").
  valueHigh          Int?
  isCumulative       Boolean        @default(true)
  /// For DEATHS: has the death been attributed to the event's pathogen by laboratory confirmation?
  deathCauseConfirmed Boolean?
  /// Geographic scope the figure applies to (e.g. "Irkutsk Oblast").
  scope              String?
  /// Date the figure refers to.
  asOfDate           DateTime?
  /// Publication time of the source reporting it (drives historical playback).
  reportedAt         DateTime
  /// OFFICIAL | MEDIA
  sourceType         String
  /// UNVERIFIED | VERIFIED | DISPUTED | REFUTED
  verificationStatus String
  /// When the verification verdict was reached (playback hides verdicts reached after asOf).
  verifiedAt         DateTime?
  attributedTo       String?
  notes              String?
  sourceArticleId    String?
  sourceArticle      SourceArticle? @relation(fields: [sourceArticleId], references: [id])
  createdAt          DateTime       @default(now())

  @@index([outbreakId, metric, reportedAt])
}

model OutbreakUpdate {
  id                 String         @id @default(cuid())
  outbreakId         String
  outbreak           Outbreak       @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  /// DEVELOPMENT | OFFICIAL_STATEMENT | MEASURE | CORRECTION | RECLASSIFICATION | MEDIA_REPORT
  kind               String
  /// Timeline category override (DEATH | SYMPTOMS | TESTING | QUARANTINE | STATEMENT | CORRECTION | EVIDENCE | CASES |
  /// SPREAD). Null = derived from the text.
  category           String?
  title              String
  body               String
  /// When the development happened (may be unknown).
  occurredAt         DateTime?
  /// When it became public.
  publishedAt        DateTime
  /// OFFICIAL | MEDIA
  sourceType         String
  /// UNVERIFIED | VERIFIED | DISPUTED | REFUTED
  verificationStatus String
  verifiedAt         DateTime?
  attributedTo       String?
  sourceArticleId    String?
  sourceArticle      SourceArticle? @relation(fields: [sourceArticleId], references: [id])
  createdAt          DateTime       @default(now())

  @@index([outbreakId, publishedAt])
}

model RiskAssessment {
  id                 String         @id @default(cuid())
  outbreakId         String
  outbreak           Outbreak       @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  organization       String
  /// Population the assessment refers to (e.g. "General population", "EU/EEA").
  scope              String
  /// VERY_LOW | LOW | LOW_TO_MODERATE | MODERATE | HIGH | VERY_HIGH | NOT_ASSESSED
  level              String
  statement          String
  publishedAt        DateTime
  verificationStatus String
  sourceArticleId    String?
  sourceArticle      SourceArticle? @relation(fields: [sourceArticleId], references: [id])
}

model Source {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  organization        String
  /// OFFICIAL | MEDIA | AGGREGATOR
  kind                String
  /// WHO_DON_API | RSS | MANUAL
  adapter             String
  url                 String?
  homepage            String?
  enabled             Boolean         @default(true)
  pollIntervalMinutes Int             @default(15)
  lastFetchAt         DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int             @default(0)
  /// Verification of the endpoint itself: UNTESTED | WORKING | FAILING | BLOCKED (network policy, not the source)
  endpointStatus      String          @default("UNTESTED")
  /// Classified cause of the last failure (lib/ingestion/errors.ts FailureKind).
  lastErrorKind       String?
  /// Last time the endpoint was checked by `npm run verify:sources` or "Test endpoint", and what it found.
  lastVerifiedAt      DateTime?
  lastVerification    String?
  /// Persisted retry schedule: earliest time the scheduler/worker may poll again (interval, or backoff after failures).
  nextAttemptAt       DateTime?
  /// Cross-process lease so two workers (or web + worker) never fetch the same source concurrently.
  leaseOwner          String?
  leaseUntil          DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  articles            SourceArticle[]
  runs                IngestionRun[]
}

model SourceArticle {
  id                 String                       @id @default(cuid())
  sourceId           String
  source             Source                       @relation(fields: [sourceId], references: [id])
  url                String
  /// Normalized URL used for deduplication.
  canonicalUrl       String                       @unique
  externalId         String?
  title              String
  summary            String?
  /// SHA-256 of normalized title — catches the same item republished under a different URL.
  titleHash          String
  language           String?
  publishedAt        DateTime
  /// Date of the underlying event, if stated.
  eventDate          DateTime?
  fetchedAt          DateTime                     @default(now())
  ingestionRunId     String?
  ingestionRun       IngestionRun?                @relation(fields: [ingestionRunId], references: [id])
  /// JSON string[] of ISO-3166 alpha-2 codes where the reported event is located (title / lead), not background mentions.
  countryCodes       String                       @default("[]")
  /// JSON string[] of other countries merely mentioned in the text (history, comparisons, travel, risk context).
  mentionedCountryCodes String                    @default("[]")
  /// OUTBREAK_REPORT | SITUATION_UPDATE | RISK_ASSESSMENT | SURVEILLANCE_REPORT | GUIDANCE | PODCAST_MEDIA |
  /// GENERAL_PUBLICATION | CORPORATE | UNCLASSIFIED (lib/ingestion/classify.ts)
  contentType        String                       @default("UNCLASSIFIED")
  /// False for guidance, podcasts, corporate and general publications: kept and shown on request, but never
  /// associated with outbreaks, never used for case-count claims and excluded from outbreak KPIs.
  outbreakRelevant   Boolean                      @default(true)
  /// Version of the extraction/classification rules that produced the derived fields (0 = before versioning).
  classifierVersion  Int                          @default(0)
  /// JSON string[] of disease slugs found in the text.
  diseaseSlugs       String                       @default("[]")
  locationText       String?
  /// EXACT | CITY | ADMIN1 | COUNTRY | UNKNOWN
  geoPrecision       String                       @default("UNKNOWN")
  /// PENDING | ACCEPTED | REJECTED | DUPLICATE
  reviewStatus       String                       @default("PENDING")
  /// OFFICIAL | MEDIA (copied from the source kind at ingest; official status is about the publisher)
  sourceType         String
  /// UNVERIFIED | VERIFIED | DISPUTED | RETRACTED
  verificationStatus String                       @default("UNVERIFIED")
  outbreakId         String?
  outbreak           Outbreak?                    @relation(fields: [outbreakId], references: [id])
  /// Suggested (not yet accepted) outbreak association from the matcher.
  suggestedOutbreakId String?
  duplicateOfId      String?
  /// Raw upstream payload (JSON) for audit.
  raw                String?
  /// SEED (compiled by hand for the initial dataset) | INGESTED (retrieved by the pipeline) | MANUAL (entered by an analyst)
  origin             String                       @default("INGESTED")
  /// When an analyst confirmed a SEED/MANUAL article's facts against the primary publication (null = not yet).
  primaryValidatedAt DateTime?
  /// Tracked event this article is about, set by lib/tracked/relevance.ts (never by hand-waving: needs a place name
  /// plus event-specific context). Null = not about any tracked event.
  trackedEventId     String?
  trackedEvent       TrackedEvent?                @relation(fields: [trackedEventId], references: [id])
  /// DIRECT (names the event's places + context) | POSSIBLE (wider-area match; needs analyst review)
  trackedLevel       String?
  trackedScore       Int?
  /// JSON string[]: PATHOGEN | LAB_RESULTS | CONTACTS | TRANSMISSION | SPREAD | DEATH | CASES | MEASURES | STATEMENT | CORRECTION
  trackedTopics      String                       @default("[]")
  /// Human-readable reasons for the match (terms found).
  trackedReasons     String?
  /// Reports a potentially material change (new lab result, case, death, spread, correction): queued for priority
  /// analyst review. Never published automatically.
  materialChange     Boolean                      @default(false)
  claims             EvidenceClaim[]
  locations          OutbreakLocation[]
  observations       OutbreakObservation[]
  updates            OutbreakUpdate[]
  riskAssessments    RiskAssessment[]
  statusChanges      InvestigationStatusHistory[]

  @@unique([sourceId, externalId])
  @@index([trackedEventId, publishedAt])
  @@index([titleHash])
  @@index([publishedAt])
  @@index([reviewStatus])
}

model EvidenceClaim {
  id                 String         @id @default(cuid())
  articleId          String?
  article            SourceArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  outbreakId         String?
  outbreak           Outbreak?      @relation(fields: [outbreakId], references: [id])
  /// CASE_COUNT | DEATH | OBSERVATION_COUNT | PATHOGEN_ID | RISK_ASSESSMENT | MEASURE | STATEMENT | LOCATION | OTHER
  claimType          String
  text               String
  /// Metric (same vocabulary as OutbreakObservation.metric) when the claim is a number.
  metric             String?
  value              Int?
  attributedTo       String?
  /// OFFICIAL | MEDIA
  sourceType         String
  /// UNVERIFIED | VERIFIED | DISPUTED | REFUTED
  verificationStatus String         @default("UNVERIFIED")
  /// Free-text description of the conflicting claim(s), set by the conflict detector or an analyst.
  conflictNote       String?
  conflictsWithId    String?
  /// AUTO | ADMIN | SEED
  extractedBy        String
  publishedAt        DateTime
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())
}

model InvestigationStatusHistory {
  id                 String         @id @default(cuid())
  outbreakId         String
  outbreak           Outbreak       @relation(fields: [outbreakId], references: [id], onDelete: Cascade)
  fromClassification String?
  toClassification   String
  fromPathogenStatus String?
  toPathogenStatus   String
  reason             String
  /// When the change became publicly supported by evidence (drives playback).
  effectiveAt        DateTime
  actor              String
  sourceArticleId    String?
  sourceArticle      SourceArticle? @relation(fields: [sourceArticleId], references: [id])
  createdAt          DateTime       @default(now())

  @@index([outbreakId, effectiveAt])
}

model IngestionRun {
  id             String          @id @default(cuid())
  sourceId       String
  source         Source          @relation(fields: [sourceId], references: [id])
  /// SCHEDULED | MANUAL | CLI | TEST
  trigger        String
  /// RUNNING | SUCCESS | PARTIAL | FAILED
  status         String
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  httpStatus     Int?
  itemsFetched   Int             @default(0)
  itemsNew       Int             @default(0)
  itemsDuplicate Int             @default(0)
  itemsFailed    Int             @default(0)
  errorMessage   String?
  /// Classified cause of a failed run (lib/ingestion/errors.ts FailureKind).
  failureKind    String?
  /// Number of upstream pages requested in this run.
  pagesFetched   Int             @default(0)
  /// JSON array of per-item error strings.
  errors         String          @default("[]")
  articles       SourceArticle[]

  @@index([sourceId, startedAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  actor      String   @default("admin")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Liveness of the ingestion process (in-process scheduler, standalone worker, or cron CLI). The public Live
/// indicator requires a recent heartbeat AND a recent real success.
model WorkerHeartbeat {
  id             String   @id
  /// inline | worker | cli
  mode           String
  host           String?
  pid            Int?
  startedAt      DateTime
  lastTickAt     DateTime
  lastTickStatus String?
  ticks          Int      @default(0)
}
